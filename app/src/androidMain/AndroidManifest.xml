<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LogRhythmApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogRhythm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LogRhythm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          Home-screen quick add. The receiver is internal; the configuration activity is
          exported because the launcher starts it directly on API < 31 (from 31 the system
          brokers it). It does nothing but write a config for an id the launcher supplied.
        -->
        <receiver
            android:name=".widget.QuickAddFoodWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quick_add_food_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_food_widget_info" />
        </receiver>

        <activity
            android:name=".widget.QuickAddFoodWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_quick_add_food_label"
            android:theme="@style/Theme.LogRhythm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
