<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows before a tile is configured (API 31+; older launchers fall back
  to previewImage, which is the same drawable). Static by necessity — the picker renders this
  without running Glance — so it shows the generic food mark and never a sample shortcut: a real
  food's icon here would imply the widget is fixed to that food.

  The mark is drawn by an ImageView rather than laid out with a background: the picker's preview
  cell is not square, and fitCenter is what keeps the round tile round in it, the same way the
  live tile squares itself to min(width, height).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_quick_add_food_label"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_quick_add_food_preview" />

</FrameLayout>
