<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular tile background for the quick-add widget in the deep_navy theme. The tile is laid out
  as a square of min(width, height) so a 1x1 cell that is taller than it is wide still reads as
  a round button rather than a stretched slab; an oval on a square is a circle. Colours mirror
  AppPalette.surfaceRaised / border in ui/theme/Theme.kt, exactly as widget_surface_deep_navy does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#FF1C2340" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
