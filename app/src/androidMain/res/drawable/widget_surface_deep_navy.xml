<?xml version="1.0" encoding="utf-8"?>
<!--
  Tile background for the quick-add widget in the deep_navy theme. A drawable rather than
  GlanceModifier.cornerRadius because that is API 31+ and minSdk is 26; the colours mirror
  AppPalette.surfaceRaised / border in ui/theme/Theme.kt.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#FF1C2340" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
