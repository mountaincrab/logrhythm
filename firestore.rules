rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validOwnedProfileDoc(uid) {
      return request.resource.data.userId == uid
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() > 0
        && request.resource.data.profileId.size() <= 128;
    }

    function ownershipUnchanged(uid) {
      return resource.data.userId == uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.profileId == resource.data.profileId;
    }

    match /users/{uid}/tracked_components/{componentId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validOwnedProfileDoc(uid)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool;
      allow update: if signedInAs(uid) && validOwnedProfileDoc(uid) && ownershipUnchanged(uid)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool;
      allow delete: if false;
    }

    match /users/{uid}/food_items/{foodItemId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validOwnedProfileDoc(uid)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.amount is string && request.resource.data.amount.size() > 0
        && request.resource.data.amount.size() <= 40
        && request.resource.data.unit is string && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.componentAmounts is map
        && request.resource.data.componentAmounts.size() <= 30
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool;
      allow update: if signedInAs(uid) && validOwnedProfileDoc(uid) && ownershipUnchanged(uid)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.amount is string && request.resource.data.amount.size() > 0
        && request.resource.data.amount.size() <= 40
        && request.resource.data.unit is string && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.componentAmounts is map
        && request.resource.data.componentAmounts.size() <= 30
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool;
      allow delete: if false;
    }

    match /users/{uid}/food_entries/{entryId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validOwnedProfileDoc(uid)
        && request.resource.data.schemaVersion == 2
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 50
        && request.resource.data.occurredAt is int
        && request.resource.data.isDeleted is bool;
      allow update: if signedInAs(uid) && validOwnedProfileDoc(uid) && ownershipUnchanged(uid)
        && request.resource.data.schemaVersion == 2
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 50
        && request.resource.data.occurredAt is int
        && request.resource.data.isDeleted is bool;
      allow delete: if false;
    }

    // Existing one-level collections retain the established account boundary. Their
    // collection-specific validation is intentionally unchanged by the food feature.
    match /users/{uid}/{collectionId}/{documentId} {
      allow read, write: if signedInAs(uid)
        && collectionId in [
          'profiles', 'poop_entries', 'note_entries', 'poop_tags', 'note_tags',
          'medications', 'medication_schedules', 'medication_entries', 'sync_meta'
        ];
    }
  }
}
